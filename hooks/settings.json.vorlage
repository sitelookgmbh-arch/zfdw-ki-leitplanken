{
  "//": "Nach .claude/settings.json kopieren. Pfade ueber $CLAUDE_PROJECT_DIR (Projektwurzel), damit die Hooks auch gefunden werden, wenn der Assistent in einem Unterverzeichnis arbeitet.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-geschuetzte-daten.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-git-status.sh"
          }
        ]
      }
    ]
  }
}
