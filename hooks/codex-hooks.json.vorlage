{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/guard-geschuetzte-daten.sh\"",
            "statusMessage": "Guard: geschuetzte Daten"
          }
        ]
      }
    ]
  }
}
